<?xml version="1.0" encoding="utf-8"?>

<component name="Chat" extends="Group">

    <interface>
        <field id="channel" type="string" onChange="onEnterChannel" alwaysNotify="true" />
        <field id="channel_id" type="string" />
        <field id="width" type="integer" value="320" onChange="applyLayout" />
        <field id="height" type="integer" value="720" onChange="applyLayout" />
        <field id="fontSize" type="integer" value="14" onChange="applyLayout" />
        <!-- Live video's distance behind the live edge in ms (set by VideoPlayer), for Chat Sync -->
        <field id="videoLatency" type="integer" value="-1" onChange="onVideoLatency" alwaysNotify="true" />
        <!-- The player's Chat Sync adjuster: shows the sync panel, and each step (1 or -1)
             shows chat a second later or earlier than Settings → Chat Sync alone would -->
        <field id="syncPanelVisible" type="bool" value="false" onChange="onSyncPanelVisible" />
        <field id="syncStep" type="integer" value="0" onChange="onSyncStep" alwaysNotify="true" />
        <function name="stopJobs" />
    </interface>

    <script type="text/brightscript" uri="Chat.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/chatEmotes.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/taskFactory.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/misc.brs" />
    <children>
        <Rectangle
            id="chatBackground"
            width="320"
            height="720"
            color="0x18181BFF" />
        <Group
            id="chatPanel"
            clippingRect="[0,0,320,720]">
            <Group id="chatContent" />
        </Group>
    </children>

</component>
